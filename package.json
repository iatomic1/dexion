{
  "name": "dexion",
  "packageManager": "bun@1.2.12",
  "version": "1.4.3",
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "2.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "ui": "bun --filter @repo/ui ui"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@databuddy/sdk": "^1.4.0",
    "cz-emoji": "^1.3.2-canary.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji",
      "cz-emoji": {
        "format": "{emoji} {typeUpperCase}({scope}): {subject}",
        "useEmoji": true,
        "align": false
      }
    }
  }
}
