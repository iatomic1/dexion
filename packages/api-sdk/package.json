{
	"name": "@dexion/api-sdk",
	"type": "module",
	"devDependencies": {
		"@dexion/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"build": "bun build ./src/index.ts --target bun --outdir ./dist",
		"test": "vitest",
		"dev": "bun run --hot src/index.ts"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@dexion/shared": "workspace:*",
		"@dexion/tokens": "workspace:*",
		"zod": "4.1.12"
	},
	"exports": {
		"./*": "./src/*"
	},
	"packageManager": "bun@1.0.18"
}
