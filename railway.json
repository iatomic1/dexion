{
	"$schema": "https://railway.app/railway.schema.json",
	"build": {
		"builder": "NIXPACKS",
		"nixpacksPlan": {
			"phases": {
				"install": {
					"cmds": ["bun install"]
				},
				"build": {
					"cmds": ["bun turbo run build --filter=@dexion/hub"]
				}
			}
		}
	},
	"deploy": {
		"startCommand": "cd apps/hub && bun run start"
	}
}
