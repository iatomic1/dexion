{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": ["bun install"]
        },
        "build": {
          "cmds": ["bun turbo run build --filter=@repo/token-watcher"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd packages/token-watcher && bun run start"
  }
}
